{
  "experiment": {
    "name": "robosuite-sdp-three-task__pi05-lora-1000demo-30k",
    "output_dir": "/data/bpc/runs/pi05"
  },
  "runtime": {
    "image": "bpc-robosuite-pi05:latest",
    "gpus": "all",
    "data_workers": [
      "local=0"
    ],
    "workers": [
      "local=0"
    ],
    "fit_workers": [
      "local=0"
    ],
    "native_python": "python",
    "openpi_root": "/opt/openpi",
    "openpi_data_home": "/data/bpc/cache/openpi",
    "native_env": {
      "PYTHONPATH": "{project}/src:/opt/openpi/src",
      "WANDB_RUN_GROUP": "robosuite-pi05-lora-1000demo-30k",
      "MUJOCO_GL": "egl",
      "PYOPENGL_PLATFORM": "egl",
      "HF_HUB_OFFLINE": "1",
      "XLA_PYTHON_CLIENT_PREALLOCATE": "false"
    },
    "shm_size": "8g",
    "mujoco_gl": "egl",
    "timezone": "America/Los_Angeles",
    "readonly_data_root": "/data"
  },
  "benchmarks": [
    {
      "kind": "robosuite",
      "dataset_dir": "/data/robosuite",
      "tasks": [
        {
          "name": "square_d0",
          "data": {
            "prompt": "fit the square nut onto the square peg"
          }
        },
        {
          "name": "stack_d0",
          "data": {
            "prompt": "stack the red block on the green block"
          }
        },
        {
          "name": "threading_d0",
          "data": {
            "prompt": "thread the needle through the tripod ring"
          }
        }
      ]
    }
  ],
  "data": {
    "demonstrations": 1000,
    "cameras": [
      "agentview_rgb",
      "eye_in_hand_rgb"
    ],
    "image_size": 224,
    "pi05": {
      "checkpoint": "/data/checkpoints/openpi/pi05_base",
      "tokenizer": "/data/checkpoints/openpi/paligemma_tokenizer.model"
    }
  },
  "policy": {
    "name": "pi05_lora",
    "image_keys": [
      "base_0_rgb",
      "left_wrist_0_rgb"
    ],
    "action_horizon": 10,
    "flow_steps": 10,
    "replan_steps": 5,
    "fitting": {
      "batch_size": 32,
      "steps": 30000,
      "seed": 42,
      "workers": 2,
      "save_interval": 1000,
      "wandb_project": "bpc-pi05-lora"
    }
  },
  "methods": [
    "pi05_lora"
  ],
  "evaluation": {
    "reset_protocol": "independent_seed",
    "init_index_start": 0,
    "init_index_stop": 300,
    "episode_seed": 100000,
    "controller_steps": 600,
    "run_full_horizon_after_success": false,
    "action_clip": [
      -1.0,
      1.0
    ],
    "save_compact_trace": true
  },
  "analysis": {
    "confidence": 0.95,
    "reference_method": "pi05_lora"
  }
}
